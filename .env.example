# Required
DATABASE_URL=postgres://orderly:orderly@localhost:5432/orderly?sslmode=disable

# Token signing
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Seals provider credentials (SMTP password, storage secret key, AI API key)
# at rest with AES-256-GCM. Generate one with:
#   openssl rand -base64 32
# Losing this key makes every stored secret permanently unreadable.
CONFIG_ENCRYPTION_KEY=

HTTP_ADDR=:8080
APP_ENV=development
LOG_LEVEL=info
BASE_DOMAIN=localhost
FRONTEND_PORT=5173
